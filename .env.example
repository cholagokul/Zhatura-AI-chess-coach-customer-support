# Copy this file to .env and fill in your real key.
# NEVER commit your real .env file.

SARVAM_API_KEY=

# Phase 2 — Sarvam speech settings (safe defaults shown; all optional)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shreya
SARVAM_TTS_SAMPLE_RATE=24000

SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODE=transcribe

# Phase 3 — live voice agent (safe defaults shown; all optional)
SARVAM_REALTIME_STT_MODEL=saaras:v4
SARVAM_STT_REALTIME_LANGUAGE=auto
SARVAM_STT_STREAM_TYPE=fast
SARVAM_STT_PROMPT=Zhatura, Zhatura AI, Zhatura AI Chess Coach, AI Chess Coach, Student Dashboard, Parent Dashboard, Coach Dashboard, Chess Academy, Chess Coach

STT_VAD_THRESHOLD=0.3
STT_SILENCE_DURATION_MS=500
STT_MIN_SPEECH_DURATION_MS=250

SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_CHAT_MAX_TOKENS=150

SARVAM_TTS_STREAM_SAMPLE_RATE=22050
MICROPHONE_SAMPLE_RATE=16000

AUTO_GREETING=true
CONVERSATION_SILENCE_TIMEOUT_SECONDS=20
MAX_CONVERSATION_TURNS=20

# ---------------------------------------------------------------
# Phase 4 — Exotel telephony (safe defaults shown; all optional)
# NOTE: the inbound Voicebot flow needs NO Exotel API credentials —
# stream/call identifiers arrive over the WebSocket itself.

EXOTEL_WEBSOCKET_HOST=0.0.0.0
EXOTEL_WEBSOCKET_PORT=8000
EXOTEL_WEBSOCKET_PATH=/ws

# Exotel Voicebot stream sample rate (8000 / 16000 / 24000).
# 16000 matches the Phase 3 realtime-STT format exactly.
EXOTEL_AUDIO_SAMPLE_RATE=16000

# Optional operational reference only — never required by the bot code.
EXOTEL_PHONE_NUMBER=

# Phase 4.1 — multilingual TTS fallback policy. STT (saaras:v4) detects
# all scheduled Sarvam languages; Bulbul v3 can speak 11 of them. When a
# caller's language has no Bulbul voice (Urdu, Assamese, Nepali,
# Konkani, Kashmiri, Sindhi, Sanskrit, Santali, Manipuri, Bodo,
# Maithili, Dogri), the bot never fakes the language — it applies this
# policy: "ask_hi_en" asks whether to continue in Hindi or English.
TTS_FALLBACK_POLICY=ask_hi_en
# Spoken fallback voice language.
TTS_FALLBACK_LANGUAGE=en-IN

# Phase 7 — real account tools + support actions settings
SUPPORT_BACKEND_MODE=mock
MOCK_VERIFICATION_ENABLED=true
ACCOUNTS_FIXTURE_PATH=

# Phase 7.1 — dual voice provider failover settings (Sarvam + ElevenLabs)
VOICE_PRIMARY_PROVIDER=sarvam
VOICE_SECONDARY_PROVIDER=elevenlabs
PROVIDER_HEALTH_COOLDOWN_SECONDS=300
MAX_PROVIDER_FAILOVERS_PER_CALL=1

# ElevenLabs credentials and model configuration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=

# Simulation failure test modes (none | stt | tts | both | quota | auth | ratelimit)
SARVAM_FAIL_MODE=none
ELEVENLABS_FAIL_MODE=none
